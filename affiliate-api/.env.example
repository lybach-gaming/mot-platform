# Add a .env file and fill in the configuration below

PORT=8085

NODE_ENV=development

# Database configuration (for Docker Compose, use these values)
# Using non-standard port 54320 to avoid conflicts with other projects
DATABASE_URL=postgresql://affiliate_user:affiliate_password_123@localhost:54320/affiliate_db

# Redis configuration (for Docker Compose)
# Using non-standard port 63790 to avoid conflicts with other projects
REDIS_URL=redis://localhost:63790

# Privy authentication
PRIVY_APP_ID=<your-privy-app-id>
PRIVY_APP_SECRET=<your-privy-app-secret>

# JWT secret for token signing
JWT_SECRET=<your-jwt-secret>

# API URLs
BASE_URL=<protocol>://<domain>
FE_URL=<protocol>://<domain>
LEGACY_API_URL=<protocol>://<domain>

# Swagger documentation password
SWAGGER_PASSWORD=<your-swagger-password>
